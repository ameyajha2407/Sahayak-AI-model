# Sahayak AI — Environment Variables
# Copy this file to .env and fill in your values.

# Google Gemini API Key (get one free at https://aistudio.google.com/app/apikey)
# If left blank, the app runs in Demo Mode with customer-grounded demo replies.
GEMINI_API_KEY=

# Optional: External Ticketing / Callback Handoff Integration (e.g., freshdesk, zendesk, salesforce)
# If left blank, escalations and after-hours callbacks run as a local demo simulation.
TICKETING_PROVIDER=
TICKETING_WEBHOOK_URL=
TICKETING_API_KEY=

# Optional: External Business Data Backend (Order / Account / Plan API)
# If left blank, lookups use the local SQLite sample/demo database (sahayak.db).
BUSINESS_DATA_PROVIDER=
BUSINESS_DATA_SOURCE_URL=
BUSINESS_DATA_API_KEY=
